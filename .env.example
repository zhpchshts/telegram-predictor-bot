# Copy this file to .env and fill in local or production values.
BOT_TOKEN=
BOT_USERNAME=ZhpchshtsPredictorBot
# Optional. Defaults to data/predictor.db.
DATABASE_PATH=data/predictor.db

# Optional. Required only for resolving exact Telegram usernames when assigning
# supermoderators. Obtain API credentials from Telegram and keep them secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telethon appends .session to this path. Use /data in production.
TELEGRAM_MTPROTO_SESSION_PATH=data/telegram-mtproto

# A slow Telegram administrator lookup must not block the participant-facing
# Mini App bootstrap. Administrative operations remain fail-closed.
TELEGRAM_ADMIN_CHECK_TIMEOUT_SECONDS=3

# Optional ordered fallback addresses for Telegram Bot API connections. DNS
# results remain primary; these addresses are additional TCP candidates and do
# not disable TLS hostname verification. Keep the operational list outside code.
TELEGRAM_BOT_API_FALLBACK_IPS=

# Telegram user IDs allowed to create and edit shared tournaments. These rights
# are global and are checked by the backend independently of chat permissions.
SHARED_TOURNAMENT_ADMIN_IDS=

# Optional. Automatic Champions League knockout synchronization stays idle
# without a token. Enable it separately for a shared tournament in the Mini App.
# The only supported value is 2026: this worker belongs to the fixed 2026/27
# Champions League tournament template and fails fast for any other season.
FOOTBALL_DATA_API_TOKEN=
CHAMPIONS_LEAGUE_SYNC_SEASON=2026
CHAMPIONS_LEAGUE_SYNC_INTERVAL_MINUTES=10

# Optional. Sends one Telegram status message after startup. Chat IDs may be
# positive or negative.
HEALTHCHECK_CHAT_ID=
